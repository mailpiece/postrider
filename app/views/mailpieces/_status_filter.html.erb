<% current = local_assigns[:status] %>
<div class="status-filter" data-controller="dialog" data-action="click@window->dialog#closeOnClickOutside keydown.esc->dialog#close">
  <%= tag.button type: "button", class: "btn status-filter__button", aria: { haspopup: "dialog", expanded: false }, data: { action: "dialog#toggle" } do %>
    <span><%= current ? status_label(current) : "Status…" %></span>
    <%= icon_tag "caret-down" %>
  <% end %>

  <dialog class="dialog panel shadow status-filter__dialog" data-dialog-target="dialog" aria-label="Status">
    <p class="margin-none txt-small txt-subtle"><strong>Status</strong></p>
    <ul class="status-filter__list">
      <li><%= link_to "All mail", root_path, aria: { current: ("page" if current.nil?) } %></li>
      <% mailpiece_status_filters.each do |status, path| %>
        <li><%= link_to status_label(status), path, aria: { current: ("page" if status == current) } %></li>
      <% end %>
    </ul>
  </dialog>
</div>
