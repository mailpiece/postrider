<% @page_title = @contact.title %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= contact_crumbs @contact %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <ul class="rows" style="--rows-margin: 0">
    <%= render "contacts/contact", contact: @contact %>
  </ul>

  <%= render "contacts/screening", contact: @contact %>

  <% if @page.used? %>
    <ul class="envelopes">
      <%= with_automatic_pagination :mailpieces, @page do %>
        <%= render partial: "mailpieces/mailpiece", collection: @page.records %>
      <% end %>
    </ul>
  <% else %>
    <div class="blank-slate fit-content center"><strong>Nothing received from this sender yet.</strong></div>
  <% end %>
</div>
