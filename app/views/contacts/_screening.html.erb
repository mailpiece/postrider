<div class="screener-question">
  <% if contact.pending? %>
    <span class="flex-item-grow">
      <strong><%= contact.title %></strong> is writing for the first time.
      <% if forward_to = local_assigns[:forward_to] %>
        Forward their mail to <%= forward_to %>?
      <% else %>
        Forward their mail?
      <% end %>
      <span class="txt-subtle"><%= pluralize contact.held_inbound_emails.size, "email" %> held</span>
    </span>
    <%= render "contacts/yes_no", contact: contact %>
  <% elsif contact.denied? %>
    <span class="flex-item-grow"><strong><%= contact.title %></strong> is screened out. Their mail is held and isn't forwarded unless you screen them in.</span>
    <%= render "contacts/screen_in", contact: contact %>
  <% else %>
    <span class="flex-item-grow">Their mail is forwarded to you.</span>
    <%= button_to "Screen them out", contact_approval_path(contact), method: :delete, class: "btn", form_class: "button_to" %>
  <% end %>
</div>
