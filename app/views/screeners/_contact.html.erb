<% flagged = contact.flagged? %>
<li id="<%= dom_id contact %>" class="row" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <%= avatar_tag contact.name, contact.email, class: "contact__avatar" %>
  <%= link_to contact_path(contact), class: "row__body flex-item-grow" do %>
    <strong class="row__title"><%= contact_phishing_mark(contact) %> <%= contact.title %></strong>
    <span class="row__meta">
      <%= safe_join [ (contact.email if contact.name.present?), "#{pluralize contact.held_inbound_emails.size, "email"} held",
            (tag.span("flagged #{contact.newest_held_email.spam_check.formatted_score}", class: "status status--warning") if flagged) ].compact, " · " %>
    </span>
  <% end %>
  <span class="row__end">
    <%= render "contacts/yes_no", contact: contact, flagged: flagged %>
  </span>
</li>
