<%= form_with url: contact_approval_path(contact), method: (contact.approved? ? :delete : :post), class: "display-contents",
      data: { controller: "forward-switch", forward_switch_confirmation_value: (forward_confirmation(contact) unless contact.approved?) } do %>
  <label class="flex align-center gap-half cursor-pointer">
    <span>Forward their mail</span>
    <span class="switch">
      <%= check_box_tag "approved", "1", contact.approved?, id: dom_id(contact, :approval),
            class: "switch__input", aria: { label: "Forward mail from #{contact.title}" },
            data: { action: "change->forward-switch#submit" } %>
      <span class="switch__btn"></span>
    </span>
  </label>
<% end %>
