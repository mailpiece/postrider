<%# locals: (selected:) %>
<%= form_with url: root_path, method: :get, class: "display-contents", data: { controller: "form", turbo_frame: "mailpieces_results", turbo_action: "advance" } do %>
  <%= tag.div class: class_names("quick-filter", "quick-filter--with-default": selected == "all"),
        data: {
          controller: "dialog combobox",
          action: "keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside",
          combobox_default_value_value: "all",
          combobox_default_label_value: "Status…",
          combobox_with_default_class: "quick-filter--with-default" } do %>
    <button type="button" class="btn input input--select flex-inline txt-x-small" data-action="click->dialog#toggle:stop">
      <span class="overflow-ellipsis" data-combobox-target="label"><%= selected == "all" ? "Status…" : status_label(selected) %></span>
    </button>

    <template data-combobox-target="hiddenFieldTemplate">
      <%= hidden_field_tag :status, nil %>
    </template>

    <%= filter_dialog "Status" do %>
      <%= filter_title "Status" %>

      <ul class="popup__list" role="listbox">
        <% Mailpiece::STATUSES.each do |status| %>
          <%= tag.li class: "popup__item", data: {
                navigable_list_target: "item", combobox_target: "item", combobox_value: status, combobox_label: status_label(status) },
                role: "checkbox", aria: { checked: selected == status } do %>
            <button type="button" class="btn popup__btn" data-action="dialog#close combobox#change form#submit">
              <span class="overflow-ellipsis flex-item-grow"><%= status_label(status) %></span>
              <%= icon_tag "check", class: "checked flex-item-justify-end" %>
            </button>
          <% end %>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>
