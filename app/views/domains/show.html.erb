<% @page_title = @domain.name %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to "Domains", domains_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <p class="margin-none txt-align-center"><%= domain_state_sentence @domain %><% if switches_sentence = domain_switches_sentence(@domain) %> <%= switches_sentence %><% end %></p>

  <% if Current.user.admin? %>
    <%= render layout: "shared/filter", locals: { what: "settings" } do %>
      <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
            data-navigable-list-actionable-items-value="true">
        <%= render "account/settings/rows", rows: domain_rows(@domain) %>
      </div>
    <% end %>
  <% end %>

  <section class="project__activity page">
    <h2 class="divider txt-medium txt-tight-lines margin-none-block-start margin-block-end">History</h2>

    <div class="trail trail--events trail--whole">
      <% domain_trail(@domain).each do |at, sentence| %>
        <article class="trail__entry">
          <%= trail_time_tag at %>
          <span class="trail__sentence"><%= sentence %></span>
        </article>
      <% end %>
    </div>
  </section>

  <% if Current.user.admin? %>
    <div class="txt-align-center margin-block-start-double pad-block-end">
      <%= button_to domain_path(@domain), method: :delete,
            class: "btn txt-negative borderless txt-small",
            data: { turbo_confirm: "Remove #{@domain.name}? All its mail and its history go with it, inbound mail to it will be rejected, and nothing can be sent from it." } do %>
        <%= icon_tag "trash" %>
        <span>Remove this domain</span>
      <% end %>
    </div>
  <% end %>
</div>
