<% @page_title = "Contacts" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb up: true %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end">
    <%= toolbar_button "Screener", screener_path, icon: "filter" %>
    <%= toolbar_button "Screened out", contacts_denied_path, icon: "cancel" %>
  </div>
<% end %>

<div class="page flex flex-column gap">
  <% if @page.used? %>
    <%= render layout: "shared/filter", locals: { what: "contacts", search: search_path } do %>
      <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
            data-navigable-list-actionable-items-value="true">
        <ul class="rows">
          <%= with_automatic_pagination :contacts, @page do %>
            <%= render partial: "contacts/contact", collection: @page.records %>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% else %>
    <div class="blank-slate fit-content center"><strong>No contacts yet.</strong> Senders you say yes to in the Screener are listed here.</div>
  <% end %>
</div>
