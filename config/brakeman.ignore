      "fingerprint": "e2c75aa3c1b7b716f2dcbe04fac1eb3a5875c8f46d10ce9c12110d20075a10cc",
      "check_name": "SSLVerify",
      "message": "SSL certificate verification was bypassed",
      "file": "app/models/smtp_delivery.rb",
      "note": "Deliberate, and covers the opportunistic default only: STARTTLS to arbitrary MX hosts, same as every mainstream MTA without DANE/MTA-STS. Requiring strict cert verification for every destination would fail delivery to a large fraction of real-world mail servers (self-signed/expired/mismatched certs) without any real security benefit, since SMTP has no way to authenticate an arbitrary receiving MTA's identity anyway. Hosts matching a suffix in Relay.require_tls_mx_suffixes (REQUIRE_TLS_MX_SUFFIXES) take a separate, verified path instead (SmtpDelivery::VERIFIED_TLS_CONTEXT), with no plaintext fallback."
    }
