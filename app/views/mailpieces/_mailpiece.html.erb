<% postable = mailpiece.postable %>
<% status = mailpiece_status(mailpiece) %>
<% if mailpiece.inbound_email? %>
  <% name, address, own = postable.contact&.name, postable.sender_address, postable.rcpt_to %>
  <% party = name.presence || address.presence || "No sender" %>
<% else %>
  <% name, address, own = nil, postable.rcpt_to, postable.mail_from %>
  <% party = "To #{address}" %>
<% end %>
<li id="<%= dom_id mailpiece %>" class="<%= class_names "row", "row--unread": status == "held" %>" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <%= avatar_tag name, address, class: "contact__avatar" %>
  <%= link_to mailpiece_path(mailpiece), class: "row__body flex-item-grow" do %>
    <span class="row__title mailpiece__title">
      <strong class="mailpiece__party"><%= phishing_mark(postable) if mailpiece.inbound_email? %> <%= party %></strong>
      <span class="row__meta mailpiece__own"><%= safe_join [ (address if name.present?), own ].compact, " · " %></span>
    </span>
    <span class="row__meta">
      <span class="mailpiece__subject"><%= envelope_subject mailpiece %></span>
    </span>
  <% end %>
  <span class="row__end mailpiece__end">
    <%= local_datetime_tag mailpiece.created_at, style: :timeordate %>
    <span class="status <%= mailpiece_status_class(status) %>"><%= status_label status %></span>
  </span>
</li>
