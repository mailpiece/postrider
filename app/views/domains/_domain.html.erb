<li id="<%= dom_id domain %>" class="row" data-quick-find-target="item" data-navigable-list-target="item" tabindex="-1">
  <%= link_to domain_path(domain), class: "row__body flex-item-grow" do %>
    <strong class="row__title"><%= domain.name %></strong>
    <span class="row__meta"><%= domain_dns_problems_line domain %></span>
  <% end %>
  <span class="row__end domain__end">
    <%= local_datetime_tag domain.dns_checked_at, style: :timeordate if domain.dns_checked? %>
    <%= domain_status_tag domain %>
  </span>
</li>
