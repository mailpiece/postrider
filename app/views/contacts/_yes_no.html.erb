<%# A sender the spam check flagged leans to No, which takes the filled button. %>
<% flagged = local_assigns[:flagged] %>
<div class="screener-decision">
  <%= button_to "Yes", contact_approval_path(contact), class: class_names("btn", "btn--positive": !flagged), form_class: "button_to",
        aria: { label: "Yes, forward mail from #{contact.title}" } %>
  <%= button_to "No", contact_approval_path(contact), method: :delete, class: class_names("btn", "btn--link": flagged), form_class: "button_to",
        aria: { label: "No, hold mail from #{contact.title}" } %>
</div>
