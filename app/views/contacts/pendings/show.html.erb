<% @page_title = "The Screener" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to "Contacts", contacts_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <p class="txt-subtle margin-none">These senders are writing to your forwarding mailboxes for the first time. You decide whether their mail goes on to you.</p>

  <% if @page.used? %>
    <section class="rows__section">
      <div class="flex align-center gap">
        <h2 class="rows__heading txt-small txt-subtle flex-item-grow">Want their mail forwarded?</h2>
        <% pending_count = Current.user.accessible_contacts.pending.count %>
        <%= button_to "Clear all…", contacts_pending_denial_path, class: "btn btn--plain txt-small txt-subtle font-weight-normal", form_class: "button_to flex-item-no-shrink",
              form: { data: { turbo_confirm: "Move all #{pluralize pending_count, "waiting sender"} to Screened out? Their mail stays held, and you can still switch any of them on from their page." } } %>
      </div>

      <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
            data-navigable-list-actionable-items-value="true">
        <ul class="rows">
          <%= with_automatic_pagination :contacts, @page do %>
            <%= render partial: "contacts/pendings/contact", collection: @page.records, locals: { email_counts: @email_counts, latest_held_emails: @latest_held_emails } %>
          <% end %>
        </ul>
      </div>
    </section>
  <% else %>
    <div class="blank-slate fit-content center">Nobody is waiting. New senders land here, their mail held until you say yes.</div>
  <% end %>
</div>
