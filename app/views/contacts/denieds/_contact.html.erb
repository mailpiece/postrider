<li id="<%= dom_id contact %>" class="row" data-navigable-list-target="item" tabindex="-1">
  <%= avatar_tag contact.name, contact.email, class: "contact__avatar" %>
  <%= link_to contact_path(contact), class: "row__body flex-item-grow" do %>
    <strong class="row__title"><%= contact_phishing_mark(contact) %> <%= contact.title %></strong>
    <span class="row__meta"><%= safe_join [ (contact.email if contact.name.present?), "#{pluralize contact.inbound_emails.held.count, "email"} held" ].compact, " · " %></span>
  <% end %>
  <span class="row__end">
    <%= render "contacts/screen_in", contact: contact %>
  </span>
</li>
