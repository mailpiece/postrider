<% at = mailpiece.created_at %>
<article class="envelope <%= status_class(status) %>" aria-label="Envelope">
  <p class="envelope__return">
    <strong><%= from.presence || "No sender" %></strong>
    <% return_lines.compact_blank.each do |line| %>
      <span><%= line %></span>
    <% end %>
  </p>

  <p class="envelope__status"><%= status_line %></p>

  <div class="envelope__postmark">
    <%= tag.time class: "envelope__cancellation", datetime: at.iso8601 do %>
      <span class="envelope__office"><%= mailpiece.domain.name %></span>
      <strong><%= l at, format: "%b %d" %></strong>
      <span><%= at.year %></span>
      <span><%= l at, format: "%H:%M" %></span>
    <% end %>
    <svg class="envelope__waves" viewBox="0 0 96 56" aria-hidden="true">
      <% [ 10, 22, 34, 46 ].each do |y| %>
        <path d="M0 <%= y %> Q12 <%= y - 6 %> 24 <%= y %> T48 <%= y %> T72 <%= y %> T96 <%= y %>" />
      <% end %>
    </svg>
  </div>

  <% if stamp %>
    <p class="envelope__stamp <%= "status--#{stamp[:semantic]}" %>">
      <span class="envelope__stamp-face">
        <%= icon_tag stamp[:icon] %>
        <strong class="envelope__verdict"><span class="for-screen-reader">Authentication:</span> <%= stamp[:verdict] %></strong>
        <% stamp[:checks].each do |check| %>
          <span><%= check %></span>
        <% end %>
        <% if stamp[:note] %>
          <span class="envelope__stamp-note"><%= stamp[:note] %></span>
        <% end %>
      </span>
    </p>
  <% end %>

  <p class="envelope__address">
    <span class="envelope__subject"><%= mailpiece.subject.presence || "(no subject)" %></span>
    <strong class="envelope__recipient"><%= to %></strong>
    <% if mx = local_assigns[:mx] %>
      <span>MX <%= mx %></span>
    <% end %>
  </p>

  <div class="envelope__inks">
    <p class="envelope__ink envelope__ink--outcome">
      <strong><%= status.humanize %></strong>
      <% if note = local_assigns[:note] %>
        <span><%= note %></span>
      <% end %>
    </p>

    <% if spam_check = local_assigns[:spam_check] %>
      <p class="envelope__ink <%= spam_check.flagged? ? "status--warning" : "status--neutral" %>">
        <span>Spam check</span>
        <strong><%= spam_check.formatted_score %></strong>
        <span><%= spam_check.outcome %></span>
      </p>
    <% end %>
  </div>

  <footer class="envelope__barcode">
    <span class="envelope__bars" aria-hidden="true">
      <% (mailpiece.postable_id * 2).each_char do |char| %>
        <span class="envelope__bar envelope__bar--<%= char.ord % 4 %>"></span>
      <% end %>
    </span>
    <span class="envelope__ids"><%= [ mailpiece.postable_id, local_assigns[:message_id], (number_to_human_size(raw_email.byte_size) if raw_email.attached?) ].compact.join(" · ") %></span>
  </footer>
</article>
