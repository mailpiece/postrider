<% held = latest_held_emails[contact.id] %>
<li id="<%= dom_id contact %>" class="row" data-navigable-list-target="item" tabindex="-1">
  <%= avatar_tag contact.name, contact.email, class: "contact__avatar" %>
  <%= link_to contact_path(contact), class: "row__body flex-item-grow" do %>
    <strong class="row__title"><%= contact_phishing_mark(contact) %> <%= contact_address(contact) %></strong>
    <% if held %>
      <span class="row__meta"><%= held.subject.presence || "(no subject)" %></span>
    <% end %>
    <span class="row__meta">
      <%= pluralize email_counts[contact.id], "email" %> held<% if held %> · <%= local_datetime_tag held.created_at, style: :date %><% end %>
    </span>
  <% end %>
  <span class="row__end">
    <%= button_to "Yes", contact_approval_path(contact), class: "btn btn--link txt-normal", form_class: "button_to flex-item-no-shrink",
          aria: { label: "Yes, forward mail from #{contact.title}" } %>
    <%= button_to "No", contact_approval_path(contact), method: :delete, class: "btn txt-normal", form_class: "button_to flex-item-no-shrink",
          aria: { label: "No, hold mail from #{contact.title}" } %>
  </span>
</li>
