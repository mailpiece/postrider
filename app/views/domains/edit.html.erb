<% @page_title = "#{@domain.name} settings" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Domains", domains_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to @domain.name, domain_path(@domain) %>
      <strong>Settings</strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page">
  <%= render layout: "shared/filter", locals: { what: "settings" } do %>
    <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
          data-navigable-list-actionable-items-value="true">
      <%= render "account/settings/rows", rows: domain_settings_rows(@domain) %>
    </div>
  <% end %>

  <%= form_with url: domain_path(@domain), method: :delete, class: "flex flex-column align-center gap-half margin-block-start-double pad-block-end txt-align-center" do |form| %>
    <%= form.label :confirm, class: "txt-small" do %>
      Removing <%= @domain.name %> deletes all its mail and its history, rejects inbound mail to it and stops sending from it.
      Type <strong><%= @domain.name %></strong> to remove it.
    <% end %>
    <%= form.text_field :confirm, class: "input txt-small", autocomplete: "off", spellcheck: false, required: true %>
    <%= form.button class: "btn txt-negative borderless txt-small" do %>
      <%= icon_tag "trash" %>
      <span>Remove this domain</span>
    <% end %>
  <% end %>
</div>
