<div class="page flex flex-column gap">
  <%= render "mailpieces/envelope", mailpiece: mailpiece, status: mailpiece_status(mailpiece), status_line: inbound_envelope_status(inbound_email),
        from: inbound_email.mail_from, return_lines: [ inbound_email.remote_host, inbound_email.remote_ip ],
        stamp: authentication_stamp(inbound_email), to: inbound_email.rcpt_to, spam_check: inbound_email.spam_check,
        message_id: inbound_email.parsed_email.message_id, raw_email: inbound_email.raw_email %>

  <article class="record">
    <% if inbound_email.incinerated? %>
      <p class="txt-small txt-subtle margin-none">Message content was incinerated on <%= local_datetime_tag inbound_email.incinerated_at, style: :date %>.</p>
    <% else %>
      <% if report = inbound_email.dmarc_report %>
        <%= render "mailpieces/dmarc_report", report: report %>
      <% end %>
      <%= render "emails/body", parsed_email: inbound_email.parsed_email, mailpiece: mailpiece %>
      <%= render "emails/attachments", attachments: inbound_email.attachments_blobs %>
    <% end %>
  </article>

  <section class="project__activity page">
    <h2 class="divider txt-medium txt-tight-lines margin-none-block-start margin-block-end">History</h2>

    <div class="trail trail--events trail--whole">
      <% inbound_email_trail(inbound_email).each do |at, sentence| %>
        <article class="trail__entry">
          <%= trail_time_tag at %>
          <span class="trail__sentence"><%= sentence %></span>
        </article>
      <% end %>
    </div>

    <% if inbound_email.raw_email.attached? %>
      <%= link_to "Download original", rails_blob_url(inbound_email.raw_email, disposition: "attachment"), class: "btn txt-small flex fit-content center", data: { turbo: false } %>
    <% end %>
  </section>

  <% if Current.user.admin? %>
    <div class="txt-align-center">
      <%= button_to mailpiece_path(mailpiece), method: :delete,
            class: "btn txt-negative borderless txt-small",
            data: { turbo_confirm: inbound_email.processed? ?
              "Delete this message permanently?" :
              "This message is still being processed. Deleting it will cancel forwarding. Delete permanently?" } do %>
        <%= icon_tag "trash" %>
        <span>Delete this mailpiece</span>
      <% end %>
    </div>
  <% end %>
</div>
