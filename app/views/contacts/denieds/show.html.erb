<% @page_title = "Screened out" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to "Contacts", contacts_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <% if @page.used? %>
    <div class="flex align-center gap">
      <p class="txt-subtle margin-none flex-item-grow">Senders you screened out. Their mail is held here, never forwarded.</p>
      <% held_count = Current.user.screened_out_mail.count %>
      <% if Current.user.admin? && held_count.positive? %>
        <%= button_to "Clear all…", contacts_screened_out_mail_path, method: :delete, class: "btn btn--plain txt-small txt-subtle font-weight-normal", form_class: "button_to flex-item-no-shrink",
              form: { data: { turbo_confirm: "Erase all #{pluralize held_count, "email"} from screened-out senders? This can't be undone. The senders stay screened out." } } %>
      <% end %>
    </div>

    <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
          data-navigable-list-actionable-items-value="true">
      <ul class="rows">
        <%= with_automatic_pagination :contacts, @page do %>
          <%= render partial: "contacts/denieds/contact", collection: @page.records %>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="blank-slate fit-content center">Nobody is screened out. Senders you say no to land here, their mail held.</div>
  <% end %>
</div>
