<% @page_title = "Add webhook" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= link_to "Domains", domains_path %>
      <span class="breadcrumbs__separator">▸</span>
      <%= link_to @domain.name, domain_path(@domain) %>
      <span class="breadcrumbs__separator">▸</span>
      <%= up_crumb_to "Webhooks", domain_webhooks_path(@domain) %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <div class="panel shadow">
    <%= form_with model: @webhook, url: domain_webhooks_path(@domain), class: "flex flex-column gap", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
      <%= render "shared/errors", record: @webhook %>

      <h2 class="txt-large margin-none">
        <%= form.text_field :name, required: true, autofocus: true, class: "input", placeholder: "Name this webhook…" %>
      </h2>

      <div class="flex flex-column gap-half">
        <%= form.label :url do %>
          <strong>Payload URL</strong>
        <% end %>
        <%= form.url_field :url, required: true, class: "input", placeholder: "https://example.com/hooks" %>
      </div>

      <div class="flex flex-column gap-half">
        <%= form.label :signing_secret do %>
          <strong>Signing secret</strong><br>
          <p class="margin-none txt-x-small txt-subtle">Generated when left blank; at least 16 characters when you give one.</p>
        <% end %>
        <%= form.password_field :signing_secret, class: "input", autocomplete: "new-password", placeholder: "Optional" %>
      </div>

      <%= render "webhooks/subscribed_actions", form: form %>

      <div class="flex gap-half">
        <%= form.button "Add webhook", type: "submit", class: "btn btn--link" %>
        <%= link_to "Cancel and go back", domain_webhooks_path(@domain), data: { form_target: "cancel" }, hidden: true %>
      </div>
    <% end %>
  </div>
</div>
