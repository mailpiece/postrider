<% @page_title = "Mailpieces" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <%= render layout: "shared/filter", locals: { what: "delivered mail", search: search_path } do %>
    <div data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
          data-navigable-list-actionable-items-value="true">
      <div class="status-stamps">
        <ul class="status-stamps__list" aria-label="By status">
          <%= render "mailpieces/status_stamp", status: "held", path: mailpieces_held_path, count: Current.user.accessible_mailpieces.held.count %>
          <%= render "mailpieces/status_stamp", status: "failed", path: mailpieces_failed_path, count: Current.user.accessible_mailpieces.failed.count %>
          <%= render "mailpieces/status_stamp", status: "withheld", path: mailpieces_withheld_path, count: Current.user.accessible_mailpieces.withheld.count %>
          <%= render "mailpieces/status_stamp", status: "deferred", path: mailpieces_deferred_path, count: Current.user.accessible_mailpieces.deferred.count %>
          <%= render "mailpieces/status_stamp", status: "queued", path: mailpieces_queued_path, count: Current.user.accessible_mailpieces.queued.count %>
          <%= render "mailpieces/status_stamp", status: "discarded", path: mailpieces_discarded_path, count: Current.user.accessible_mailpieces.discarded.count %>
        </ul>
      </div>

      <% if @page.used? %>
        <section class="envelopes__section">
          <h2 class="rows__heading txt-small txt-subtle">Delivered</h2>
          <ul class="envelopes">
            <%= with_automatic_pagination :mailpieces, @page do %>
              <%= render partial: "mailpieces/mailpiece", collection: @page.records %>
            <% end %>
          </ul>
        </section>
      <% else %>
        <div class="blank-slate fit-content center"><strong><%= Current.user.accessible_mailpieces.exists? ? "No delivered mail." : "No mail recorded yet." %></strong></div>
      <% end %>
    </div>
  <% end %>
</div>
