<li class="<%= class_names "post-box", status_class(status) => count.positive? %>" data-navigable-list-target="item" tabindex="-1">
  <%= link_to path, class: "post-box__link" do %>
    <span class="post-box__window" aria-hidden="true">
      <% [ count, 4 ].min.times do %>
        <span class="post-box__slip"></span>
      <% end %>
    </span>
    <strong class="post-box__name"><%= status.humanize %></strong>
    <span class="post-box__count"><%= number_with_delimiter count %></span>
  <% end %>
</li>
