<% @page_title = "The Screener" %>
<% content_for :header do %>
  <h1 class="header__title">
    <span class="breadcrumbs">
      <%= home_crumb %>
      <%= up_crumb_to "Contacts", contacts_path %>
      <strong><%= @page_title %></strong>
    </span>
  </h1>
  <div class="header__actions header__actions--end"></div>
<% end %>

<div class="page flex flex-column gap">
  <% if @contacts.any? %>
    <div class="flex align-center gap">
      <p class="txt-subtle margin-none flex-item-grow"><%= pluralize @contacts.size, "new sender" %>. Their mail is held until you say yes.</p>
      <% if @waiting.any? %>
        <%= button_to "Screen out all…", screener_denial_path, class: "btn btn--plain txt-small txt-subtle font-weight-normal", form_class: "button_to flex-item-no-shrink",
              form: { data: { turbo_confirm: "Move all #{pluralize @contacts.size, "waiting sender"} to Screened out? Their mail stays held, and you can still screen any of them in from their page." } } %>
      <% end %>
    </div>

    <div class="flex flex-column gap" data-controller="navigable-list" data-action="keydown->navigable-list#navigate turbo:before-visit@document->navigable-list#rememberSelection turbo:frame-load->navigable-list#forgetSelection"
          data-navigable-list-actionable-items-value="true">
      <% if @waiting.any? %>
        <ul class="rows" style="--rows-margin: 0">
          <%= render partial: "screeners/contact", collection: @waiting %>
        </ul>
      <% end %>

      <% if @flagged.any? %>
        <div class="flex align-center gap">
          <h2 class="txt-small txt-warning margin-none flex-item-no-shrink">Flagged by the spam check</h2>
          <p class="txt-small txt-subtle margin-none flex-item-grow">Their mail scored as spam. Still yours to decide, but No is one tap.</p>
          <%= button_to "Screen out all flagged…", screener_flagged_denial_path, class: "btn btn--plain txt-small txt-subtle font-weight-normal", form_class: "button_to flex-item-no-shrink",
                form: { data: { turbo_confirm: "Move #{pluralize @flagged.size, "flagged sender"} to Screened out? Their mail stays held, and you can still screen any of them in from their page." } } %>
        </div>

        <ul class="rows" style="--rows-margin: 0">
          <%= render partial: "screeners/contact", collection: @flagged %>
        </ul>
      <% end %>
    </div>
  <% else %>
    <div class="blank-slate fit-content center">Nobody is waiting. New senders land here, their mail held until you say yes.</div>
  <% end %>
</div>
